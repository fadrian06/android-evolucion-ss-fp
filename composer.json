{
  "require": {
    "php": ">=8.4.27",
    "flightphp/core": "^3.19",
    "ext-pdo_sqlite": "*",
    "leafs/auth": "^5.1",
    "illuminate/database": "^13.43",
    "leafs/lingo": "^5.0",
    "symfony/dotenv": "^8.1",
    "guzzlehttp/guzzle": "^8.5",
    "leafs/form": "^5.0",
    "leafs/http": "^5.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app"
    },
    "files": [
      "app/functions.php"
    ]
  },
  "require-dev": {
    "symfony/var-dumper": "^8.1",
    "phpunit/phpunit": "^13.4",
    "carthage-software/mago": "^1.60"
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests"
    }
  }
}
